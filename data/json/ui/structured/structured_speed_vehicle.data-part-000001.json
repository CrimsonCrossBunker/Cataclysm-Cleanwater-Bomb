[
  {
    "id": "structured_wield_speed_vehicle_layout",
    "type": "widget",
    "style": "layout",
    "arrange": "minimum_columns",
    "width": 27,
    "clauses": [
      {
        "id": "not_controlling_vehicle",
        "widgets": [ "structured_wield_simple", "structured_speed_layout" ],
