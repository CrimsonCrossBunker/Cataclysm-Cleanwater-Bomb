[
  {
    "type": "technique",
    "id": "tec_brawl_power",
    "name": "Power Hit",
    "messages": [ "You send %s reeling", "<npcname> sends %s reeling" ],
    "skill_requirements": [ { "name": "unarmed", "level": 4 } ],
    "unarmed_allowed": true,
    "crit_tec": true,
    "knockback_dist": 1,
    "stun_dur": 1,
    "//condition": "Similar size",
    "condition": {
      "and": [
        { "math": [ "u_val('size') >= n_val('size')" ] },
        { "not": { "npc_has_effect": "downed" } },
        { "not": { "npc_has_effect": "stunned" } }
      ]
    },
    "condition_desc": "* Only works on a <info>non-downed and non-stunned</info> target of <info>similar or smaller</info> size",
    "attack_vectors": [ "vector_punch", "vector_slime_punch", "vector_paw_rat_punch", "vector_little_paw_punch" ]
  },
  {
    "type": "technique",
    "id": "tec_brawl_trip",
    "name": "Trip",
    "messages": [ "You trip %s", "<npcname> trips %s" ],
    "skill_requirements": [ { "name": "unarmed", "level": 5 } ],
    "unarmed_allowed": true,
    "condition": {
      "and": [
        { "math": [ "u_val('size') + 1 >= n_val('size')" ] },
        { "math": [ "u_val('size') - 1 <= n_val('size')" ] },
        { "or": [ { "npc_bodytype": "angel" }, { "npc_bodytype": "human" } ] },
        { "not": { "npc_has_effect": "downed" } }
      ]
    },
    "condition_desc": "* Only works on a <info>non-downed humanoid</info> target of <info>similar</info> size",
    "down_dur": 1,
    "attack_vectors": [ "vector_shin" ]
  }
]
