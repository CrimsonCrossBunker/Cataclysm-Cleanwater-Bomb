      { "stat": "damage", "type": "bash", "scale": 1.25 },
      { "stat": "damage", "type": "cut", "scale": 1.25 },
      { "stat": "damage", "type": "stab", "scale": 1.25 }
    ],
    "attack_vectors": [ "vector_foot_toes", "vector_avian_talons", "vector_hoof_kick", "vector_digitigrade_paws" ]
