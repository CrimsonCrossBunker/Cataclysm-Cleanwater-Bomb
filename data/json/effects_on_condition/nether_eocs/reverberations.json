              { "u_mutate_category": "INTERSTICE", "use_vitamins": false }
            ]
          }
        ],
        "else": [ { "u_lose_trait": "INTERSTICE_GROWING" }, { "u_add_trait": "INTERSTICE_SHRINKING" } ]
      }
    ],
