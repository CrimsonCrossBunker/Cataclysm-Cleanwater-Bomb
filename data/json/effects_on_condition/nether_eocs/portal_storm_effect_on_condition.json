  {
    "id": "EOC_DEATH_PORTAL_DUNGEON",
    "type": "effect_on_condition",
    "eoc_type": "AVATAR_DEATH",
    "condition": { "current_dimension": "portal_storm_dungeon_dimension" },
    "effect": [
      {
        "if": { "math": [ "u_val('pos_z') <= -1" ] },
        "then": {
          "u_message": "You fall, and fall, and fall, through an endless black void devoid of stars.  No light.  No sound.  No sensation of wind.  You try to shout, to scream, but hear nothing.  When you try to grab your own hand, you cannot feel it.  There is only the dark.\n\nPerhaps fortunately, your mind gives way before your body does.",
          "popup": true
        },
        "else": {
          "u_message": "Your ultimate fate is hard to sum up in words but suffice to say, the thing that used to be you wishes it had hidden from the storm.",
          "popup": true
        }
      }
    ]
  },
