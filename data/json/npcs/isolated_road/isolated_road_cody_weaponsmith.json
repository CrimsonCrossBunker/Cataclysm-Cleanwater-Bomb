  {
    "id": "TALK_BLACKSMITH_WEAPON_READY",
    "type": "talk_topic",
    "dynamic_line": {
      "math": [
        "time_since(u_timer_artisans_u_waiting_on_weapon, 'unit':'days') >= u_number_artisans_blacksmith_weapon_wait"
      ],
      "yes": "It's all done!  Sorry for the long wait; hopefully it's worth it.",
      "no": "Still working on it."
    },
    "responses": [
      {
        "text": "Thanks.",
        "condition": {
          "math": [
            "time_since(u_timer_artisans_u_waiting_on_weapon, 'unit':'days') >= u_number_artisans_blacksmith_weapon_wait"
          ]
        },
        "switch": true,
        "effect": [
          {
            "u_add_var": "dialogue_artisans_blacksmith_crafting",
            "value": "no"
          },
          {
            "u_add_var": "dialogue_artisans_u_current_project",
            "value": "none"
          },
          {
            "u_spawn_item": {
              "u_val": "general_artisans_blacksmith_weapon"
            }
          },
          {
            "run_eocs": [
              "EOC_blacksmith_weapon_cleanup"
            ]
          }
        ],
        "topic": "TALK_BLACKSMITH_SERVICES"
      },
      {
        "text": "See you when it's done.",
        "switch": true,
        "topic": "TALK_DONE"
      }
    ]
