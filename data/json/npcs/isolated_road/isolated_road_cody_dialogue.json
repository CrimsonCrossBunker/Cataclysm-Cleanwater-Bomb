            { "compare_string": [ "yes", { "u_val": "dialogue_artisans_blacksmith_crafting_EXODII" } ] }
          ]
        },
        "topic": "TALK_BLACKSMITH_PROTOTYPE_EXODII_ITEMS"
      },
      {
        "text": "Let's trade.",
        "condition": { "compare_string": [ "yes", { "u_val": "dialogue_artisans_blacksmith_heard_the_deal" } ] },
