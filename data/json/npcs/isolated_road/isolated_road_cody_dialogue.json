        { "u_add_var": "u_met_isolated_road_cody", "value": "yes" },
        { "npc_add_effect": "npc_said", "duration": 600 }
      ]
    },
    "responses": [
      { "text": "About that contract…", "topic": "TALK_MISSION_INQUIRE", "condition": "has_assigned_mission" },
