    "type": "talk_topic",
    "dynamic_line": [
      "Hiya darlin', welcome to the shop.",
      "Hey, killer!  How's it going?",
      { "gendered_line": "You look like you haven't eaten in days.", "relevant_genders": [ "u" ] },
