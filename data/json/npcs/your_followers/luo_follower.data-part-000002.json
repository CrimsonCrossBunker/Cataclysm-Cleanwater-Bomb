            { "not": "u_driving" },
            { "not": "npc_driving" },
            { "not": "is_by_radio" },
            { "not": { "u_has_effect": "asked_to_train" } },
            { "not": { "npc_has_trait": "HALLUCINATION" } }
          ]
        },
        "topic": "TALK_TRAIN_NPC"
      },
      {
        "text": "Let's trade items.",
