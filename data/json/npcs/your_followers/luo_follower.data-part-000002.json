      },
      {
        "text": "Guard this position.",
        "condition": { "not": "is_by_radio" },
        "topic": "TALK_FRIEND_GUARD_Luo",
        "effect": "assign_guard"
      },
      {
        "text": "Find a horse and mount up!",
