  {
    "id": "TALK_ROBOFAC_INTERCOM_REPAIR",
    "type": "talk_topic",
    "dynamic_line": {
      "math": [ "u_timer_hub_rnd_u_waiting_on_hub < time('now')" ],
      "yes": "The repairs and tuneup are complete.  Should be good as new or better.",
      "no": "Work is still ongoing.  These things can take time."
