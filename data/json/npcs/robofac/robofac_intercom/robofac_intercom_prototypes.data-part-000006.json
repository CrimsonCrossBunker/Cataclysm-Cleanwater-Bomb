            { "u_has_items": { "item": "dimensional_anchor", "count": 1 } }
          ]
        },
        "effect": [
          { "u_consume_item": "RobofacCoin", "count": 2, "popup": true },
          { "u_consume_item": "dimensional_anchor", "count": 1, "popup": true },
          { "u_add_faction_trust": 1 },
