            { "u_has_perception": 6 }
          ]
        }
      },
      {
        "text": "What's with those weird metal zombies I've been seeing?  They resemble some of the robots around here.",
        "condition": {
          "and": [
            { "not": { "test_eoc": "EOC_CONDITION_XE_YOU_ARE_FAIR_FOLK" } },
            { "compare_string": [ "yes", { "u_val": "dialogue_exodii_seen_zomborg" } ] }
          ]
        },
        "topic": "TALK_EXODII_MERCHANT_Zomborgs"
      },
      {
        "text": "I'd feel strange saying this to anyone else, but I think I may have found a place with similar tech to yours in… well… what you might call an \"otherworld\".",
        "condition": {
          "and": [
            { "not": { "test_eoc": "EOC_CONDITION_XE_YOU_ARE_FAIR_FOLK" } },
            { "compare_string": [ "yes", { "u_val": "u_found_string_dimension_exodii" } ] },
            { "compare_string": [ "yes", { "u_val": "knowledge_exodii_transdimensional_u_knows_exodiilore" } ] },
            { "not": { "u_has_mission": "EXODII_MISSION_STRING_DIMENSION_EXODII" } },
            {
              "not": { "compare_string": [ "yes", { "u_val": "mission_completed_u_returned_string_dimension_data" } ] }
            }
          ]
        },
        "topic": "TALK_EXODII_MERCHANT_String_Dimension_Exodii"
      },
      {
        "text": "Actually, I was wondering were I might get more of these CBMs.  Anything I can do to help make or find them?",
        "condition": {
          "and": [
