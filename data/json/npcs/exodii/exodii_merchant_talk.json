        "condition": { "not": { "test_eoc": "EOC_CONDITION_XE_YOU_ARE_FAIR_FOLK" } }
      },
      {
        "text": "[INT 9] You're called Exodii?  Does that mean you were driven out of your home?",
        "condition": { "and": [ { "u_has_intelligence": 9 }, { "not": { "test_eoc": "EOC_CONDITION_XE_YOU_ARE_FAIR_FOLK" } } ] },
        "topic": "TALK_EXODII_MERCHANT_Exodus"
      },
      {
        "text": "What are you doing here?",
