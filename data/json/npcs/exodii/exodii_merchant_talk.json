      },
      {
        "text": "What kind of place is this?",
        "topic": "TALK_EXODII_MERCHANT_Base",
        "condition": { "not": { "test_eoc": "EOC_CONDITION_XE_YOU_ARE_FAIR_FOLK" } }
      },
      {
        "text": "[PER 6] Some of this tech looks… weird.",
        "topic": "TALK_EXODII_MERCHANT_Tech",
