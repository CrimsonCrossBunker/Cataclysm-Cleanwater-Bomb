          ]
        },
        "topic": "TALK_EXODII_MERCHANT_netherum_labyrinth_intro"
      },
      {
        "text": "So you know about AltarOS, or at least where it's from.  Do you have a way to get back there?",
        "condition": {
          "and": [
            { "u_has_trait": "NL_CBM_Interface" },
            { "not": { "compare_string": [ "yes", { "u_val": "rubik_told_about_labyrinth" } ] } },
            { "compare_string": [ "yes", { "u_val": "scenario_trapped_in_labyrinth" } ] }
          ]
        },
        "topic": "TALK_EXODII_MERCHANT_netherum_labyrinth_intro_NL_interface"
      },
      {
        "text": "I think there's something wrong with that labyrinth teleporter computer.  It's giving some error when I try to use it.",
        "condition": {
          "and": [
            { "u_has_trait": "CBM_Interface" },
            { "compare_string": [ "yes", { "u_val": "rubik_told_about_labyrinth" } ] },
