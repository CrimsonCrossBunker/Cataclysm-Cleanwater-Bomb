        "topic": "TALK_DONE",
        "effect": "drop_items_in_place"
      },
      {
        "text": "Get off your mount, please.",
        "condition": "npc_is_riding",
        "topic": "TALK_DONE",
        "effect": "dismount"
      },
      { "text": "Let's talk about your current activity.", "topic": "TALK_ACTIVITIES" },
      { "text": "Let's talk about the camp.", "topic": "TALK_CAMP" },
