      ]
    },
    "condition_desc": "* Only works on a <info>non-downed humanoid</info> target of <info>identical or smaller</info> size",
    "down_dur": 1,
    "mult_bonuses": [ { "stat": "movecost", "scale": 0.8 }, { "stat": "damage", "type": "bash", "scale": 2.0 } ],
    "attack_vectors": [ "vector_punch", "vector_slime_punch", "vector_paw_rat_punch", "vector_little_paw_punch" ]
  },
  {
    "type": "technique",
    "id": "tec_swordsmanship_ringen",
