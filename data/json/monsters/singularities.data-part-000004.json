[
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_SETUP",
    "eoc_type": "EVENT",
    "required_event": "game_start",
    "//": "This marks the reclaimer as unkilled when the game starts.  The kill event only allows encounters once 50 days have passed since the cataclysm.",
    "//2": "can_appear tracks if the reclaimer is still unkilled, while next_spawn stores the earliest time of the next encounter.",
    "effect": [ { "math": [ "reclaimer_can_appear = 1" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_CHECK_KILL_AMOUNT",
    "eoc_type": "EVENT",
    "//": "This counts any zombie killed by the player, NPCs and things they cause and summon.",
    "//2": "Kills are only counted when the reclaimer could be spawned.  Since a featureless mass of flesh can't really swim or float, it will not appear near sufficient volumes of water or on anything on water.",
    "//32": "When possible, this should also count zombies killed by hostile monsters.",
    "required_event": "character_kills_monster",
    "condition": {
      "and": [
        { "npc_has_species": "ZOMBIE" },
        { "math": [ "time_since('cataclysm', 'unit':'days') >= 50" ] },
        { "math": [ "reclaimer_can_appear == 1" ] },
        { "math": [ "time('now') >= reclaimer_next_spawn" ] },
        {
          "not": {
