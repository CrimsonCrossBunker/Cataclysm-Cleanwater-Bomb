    "effect": [
      { "math": [ "reclaimer_zombies_required_standing = rng(45, 55)" ] },
      { "math": [ "reclaimer_zombies_required_killed = rng(45, 55)" ] },
      { "math": [ "reclaimer_zombies_killed_warning = rng(25, 30)" ] },
      {
        "if": {
          "math": [ "u_mon_species_nearby('ZOMBIE', 'radius': 55, 'attitude': 'hostile') > reclaimer_zombies_required_standing" ]
        },
        "then": [ { "math": [ "zombies_recently_killed++" ] } ]
      },
      {
        "if": {
          "and": [
            { "math": [ "zombies_recently_killed > reclaimer_zombies_required_killed" ] },
            {
              "math": [ "u_mon_species_nearby('ZOMBIE', 'radius': 55, 'attitude': 'hostile') > reclaimer_zombies_required_standing" ]
            }
          ]
        },
        "then": [ { "run_eocs": "EOC_SINGULARITY_RECLAIMER_APPEAR", "alpha_talker": "avatar" } ],
        "else": {
          "if": {
            "and": [
              { "math": [ "zombies_recently_killed > reclaimer_zombies_killed_warning" ] },
              {
                "math": [ "u_mon_species_nearby('ZOMBIE', 'radius': 55, 'attitude': 'hostile') >= reclaimer_zombies_required_standing" ]
              },
              { "math": [ "reclaimer_recent_warning == 0" ] }
            ]
          },
          "then": [
            {
              "if": { "math": [ "reclaimer_first_warning == 0" ] },
              "then": { "u_message": "Reclaimer_Warnings_Snippets", "snippet": true, "popup": true },
              "else": { "u_message": "Reclaimer_Warnings_Snippets", "snippet": true, "popup": false }
            },
            { "math": [ "reclaimer_first_warning = 1" ] },
            { "math": [ "reclaimer_recent_warning = 1" ] }
          ]
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_APPEAR",
    "//": "Makes the reclaimer appear near the player for approximately a minute, zeroes out the kill counter and prevents another encounter for seven days.",
    "//2": "Ever forced ground meat through a mesh colander?  It appears and retreats out of the ground in a similar way, oozing through anything on its way.  It still need space on the other side to emerge, so it only appears outdoors.",
    "effect": [
      {
        "u_location_variable": { "context_val": "reclaimer_spawn_spot" },
        "passable_only": true,
        "outdoor_only": true,
        "z_adjust": 0,
        "z_override": true,
        "min_radius": 15,
        "max_radius": 30,
        "true_eocs": [ "EOC_SINGULARITY_RECLAIMER_APPEAR_NEARBY" ],
        "false_eocs": [ "EOC_SINGULARITY_RECLAIMER_APPEAR_FAIL" ]
      },
      { "math": [ "zombies_recently_killed = 0" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_APPEAR_NEARBY",
    "effect": [
      {
        "u_spawn_monster": "mon_singularity_reclaimer",
        "target_var": { "context_val": "reclaimer_spawn_spot" },
        "real_count": 1,
        "outdoor_only": true
      },
      { "math": [ "reclaimer_can_appear = 0" ] },
      { "math": [ "reclaimer_next_spawn = time('now') + time('7 days')" ] },
      { "math": [ "mon_singularity_reclaimer_time_active = 0" ] },
      {
        "u_message": "Something emerges from below as the zombie hits the ground…",
        "type": "bad",
        "popup": true,
        "popup_w_interrupt_query": true,
        "interrupt_type": "eoc"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_APPEAR_FAIL",
    "effect": [
      { "u_message": "A chill runs down your spine as the zombie hits the ground, but it quickly passes.", "type": "mixed" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_RECLAIMER_WITHDRAWS_FOR_NOW",
    "recurrence": "1 second",
    "global": true,
    "run_for_npcs": false,
    "//1": "A minute or so after it appeared or you're about to outrun it (55 tiles away).",
    "condition": {
      "and": [
        {
          "or": [
            { "math": [ "mon_singularity_reclaimer_time_active >= rng(50, 70)" ] },
            { "math": [ "u_monsters_nearby('mon_singularity_reclaimer', 'radius': 55) == 0" ] }
          ]
        },
        { "math": [ "u_monsters_nearby('mon_singularity_reclaimer', 'radius': 60) > 0" ] }
      ]
    },
    "//2": "Despawn the reclaimer, adjust var for later to let it respawn.",
    "//3": "Reuses the Shadow's EOC as they are identical in effect.",
    "effect": [
      { "math": [ "reclaimer_can_appear = 1" ] },
      { "u_add_effect": "blind_no_msg", "duration": "0 second" },
      {
        "u_location_variable": { "global_val": "mon_singularity_reclaimer" },
        "monster": "mon_singularity_reclaimer",
        "target_min_radius": 0,
        "target_max_radius": 60
      },
      { "run_eocs": "EOC_KILL_SHADOW", "beta_loc": { "global_val": "mon_singularity_reclaimer" } },
      { "u_message": "The reclaimer sinks back into the ground", "type": "good" },
      { "u_message": "…but it will return.", "type": "bad" }
    ],
    "false_effect": [
      {
        "if": { "math": [ "u_monsters_nearby('mon_singularity_reclaimer', 'radius': 60) > 0" ] },
        "then": [ { "math": [ "mon_singularity_reclaimer_time_active++" ] } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_LOWER_KILL_AMOUNT",
    "recurrence": [ "50 seconds", "70 seconds" ],
    "global": true,
    "run_for_npcs": false,
    "//": "This reduces the variable over time, so the encounter cannot be triggered by periodic killing.",
    "condition": { "math": [ "zombies_recently_killed > 0" ] },
    "deactivate_condition": { "math": [ "reclaimer_can_appear == 0" ] },
    "effect": [ { "math": [ "zombies_recently_killed--" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SINGULARITY_RECLAIMER_RESET_SPAWN",
    "recurrence": "7 days",
    "global": true,
    "run_for_npcs": false,
    "//": "This resets the variable that stops the reclaimer from spawning and warning too often.",
    "condition": {
