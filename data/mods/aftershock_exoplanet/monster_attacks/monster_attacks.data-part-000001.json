  {
    "id": "EOC_SHOCK_MINE_CONTROL",
    "type": "effect_on_condition",
    "effect": [
      {
        "if": { "math": [ "has_var(u_death_timer)" ] },
        "then": [ { "if": { "math": [ "time_since(u_death_timer) > time(' 8 h')" ] }, "then": [ "u_die" ] } ],
        "else": [ { "math": [ "u_death_timer = time('now')" ] } ]
      }
    ]
  }
