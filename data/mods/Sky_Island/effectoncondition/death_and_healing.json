      { "math": [ "u_hp('ALL') = 999" ] },
      { "run_eocs": [ "EOC_healextras" ] }
    ],
    "false_effect": [
      {
        "u_message": "The effect is wasted and you don't feel any better.  You have to be in your sanctuary to be healed by this!"
      }
    ]
  },
