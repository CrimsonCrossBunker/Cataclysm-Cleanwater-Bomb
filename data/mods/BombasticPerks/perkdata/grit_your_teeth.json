[
  {
    "type": "effect_type",
    "id": "effect_perk_grit_your_teeth_cooldown",
    "//": "No name or description to hide effect",
    "name": [ "" ],
    "desc": [ "" ],
    "rating": "bad"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PERK_GRIT_YOUR_TEETH",
    "condition": { "not": { "u_has_any_effect": [ "effect_perk_grit_your_teeth_cooldown", "pain_relief" ] } },
    "effect": [
      { "math": [ "_grit_pain = u_pain('type': 'perceived')" ] },
      {
        "if": { "math": [ "_grit_pain > 0" ] },
        "then": [
          { "u_add_effect": "effect_perk_grit_your_teeth_cooldown", "duration": { "math": [ "_grit_pain * 60" ] } },
          {
            "u_add_effect": "pain_relief",
            "duration": "3 minutes",
            "intensity": { "math": [ "min(_grit_pain, max(30, ceil(_grit_pain / 2)))" ] }
          }
        ]
      }
    ],
    "false_effect": [ { "u_message": "You need more time to collect yourself before you can grit your teeth again.", "type": "mixed" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PERK_GRIT_YOUR_TEETH_DEACTIVATE",
    "//": "Only queued activations from old saves need to repay base pain. New uses never subtract it.",
    "condition": { "math": [ "u_grit_your_teeth_pain_value_removed > 0" ] },
    "effect": [
      { "math": [ "_grit_legacy_pain = u_grit_your_teeth_pain_value_removed" ] },
      { "math": [ "u_grit_your_teeth_pain_value_removed = 0" ] },
      { "math": [ "u_pain('type': 'base') += _grit_legacy_pain" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PERK_GRIT_YOUR_TEETH_BACKUP_REMOVE",
    "eoc_type": "EVENT",
    "required_event": "character_wakes_up",
    "//": "A backup to remove the cooldown in case the character ends up with a million pain or something.",
    "condition": { "u_has_effect": "effect_perk_grit_your_teeth_cooldown" },
    "effect": [ { "u_lose_effect": "effect_perk_grit_your_teeth_cooldown" } ]
  }
]
