[
  {
    "id": "EOC_MANA_LEECH_PLAYER_NOT_WORN",
    "//": "Mana-leech shackles quickly become inert if not worn by a living being.",
    "type": "effect_on_condition",
    "recurrence": [ "1 hour", "1 hour" ],
    "condition": { "and": [ { "not": { "u_is_wearing": "mana_leech_shackle" } }, { "u_has_item": "mana_leech_shackle" } ] },
    "global": true,
    "run_for_npcs": true,
    "effect": [
      { "u_remove_item_with": "mana_leech_shackle" },
      { "u_spawn_item": "mana_leech_shackle_unlocked", "suppress_message": true }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_HYBRASIL_ENCHANTMENT",
    "effect": [
      {
        "switch": { "math": [ "u_hp('torso')" ] },
        "cases": [
          { "case": 0, "effect": { "u_cast_spell": { "id": "druid_summon_brambles_arc" }, "targeted": true } },
          { "case": 25, "effect": { "u_cast_spell": { "id": "pain_split", "hit_self": true } } },
          { "case": 50, "effect": { "u_cast_spell": { "id": "recover_stamina", "hit_self": true } } },
          { "case": 75, "effect": { "u_cast_spell": { "id": "druid_thorn_skin", "hit_self": true } } }
        ]
      }
    ]
  }
]
