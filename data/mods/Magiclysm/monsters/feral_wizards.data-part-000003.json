              { "not": { "u_has_effect": "maimed_arm" } }
            ]
          },
          "monster_message": "%1$s mutters some words and their body is limned in light."
        },
        {
          "id": "feral_high_technomancer_invisibility",
          "type": "spell",
          "spell_data": { "id": "feral_invisibility", "min_level": 2, "hit_self": true },
          "cooldown": 20,
          "condition": {
