        { "case": 14, "effect": { "u_cast_spell": { "id": "summon_zombie_brute" } } },
        { "case": 21, "effect": { "u_cast_spell": { "id": "summon_skeleton" } } },
        { "case": 28, "effect": { "u_cast_spell": { "id": "summon_skeleton_brute" } } },
        { "case": 35, "effect": { "u_cast_spell": { "id": "summon_skeleton_hulk" } } }
      ]
    }
  }
