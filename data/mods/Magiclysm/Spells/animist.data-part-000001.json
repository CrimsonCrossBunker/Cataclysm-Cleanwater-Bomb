  {
    "type": "effect_on_condition",
    "id": "EOC_SUMMON_ZOMBIE",
    "effect": {
      "switch": { "math": [ "u_spell_level('summon_undead')" ] },
      "cases": [
        { "case": 0, "effect": { "u_cast_spell": { "id": "summon_zombie" } } },
