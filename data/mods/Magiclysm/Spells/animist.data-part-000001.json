    "base_casting_time": 3000,
    "flags": [ "CONJURATION_SPELL", "SOMATIC", "VERBAL", "CONCENTRATE", "CONSUMES_RUNES" ],
    "min_duration": 36000,
    "max_duration": 1080000,
    "duration_increment": 36000,
    "extra_effects": [ { "id": "eoc_summon_setup", "hit_self": true } ]
