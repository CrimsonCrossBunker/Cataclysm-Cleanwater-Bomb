[
  {
    "id": "biomancer_baleful_polymorph_npcs",
    "type": "SPELL",
    "name": {
      "str": "Fleshwarping NPCs",
      "//~": "NO_I18N"
    },
    "description": {
      "str": "Transform your enemies into wretches if they're NPCs.",
      "//~": "NO_I18N"
    },
    "valid_targets": [
      "hostile"
    ],
    "flags": [
      "TRANSFORMATION_SPELL",
      "VERBAL",
      "SOMATIC",
      "NO_LEGS",
      "NO_PROJECTILE"
    ],
    "effect": "effect_on_condition",
    "effect_str": "EOC_BIOMANCER_BALEFUL_POLYMORPH_NPCS",
    "shape": "blast",
    "spell_class": "BIOMANCER",
    "magic_type": "magiclysm_transformation_magic",
    "max_level": 20,
    "min_range": {
      "math": [
        "1 + max( ( ( u_spell_level('biomancer_baleful_polymorph') - 10) * 0.25 ), 0)"
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BIOMANCER_BALEFUL_POLYMORPH_NPCS",
    "condition": "u_is_character",
    "effect": [
      {
        "math": [
          "_lower_damage_limit = ( ( ( n_spell_level('biomancer_baleful_polymorph') * 1.5 ) + 10) * magiclysm_spell_failure_transformation_proficiency_adjustments_damage_npc() )"
        ]
      },
      {
        "math": [
          "_upper_damage_limit = ( ( ( n_spell_level('biomancer_baleful_polymorph') * 3.6 ) + 25) * magiclysm_spell_failure_transformation_proficiency_adjustments_damage_npc() )"
        ]
      },
      {
        "math": [
          "u_baleful_polymorph_damage",
          "=",
          "rng( _lower_damage_limit, _upper_damage_limit )"
        ]
      },
      {
        "math": [
          "u_health_comparison",
          "=",
          "(u_hp('arm_l') + u_hp('arm_r') + u_hp('leg_l') + u_hp('leg_r') + u_hp('torso') + u_hp('head')) / 3"
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "u_baleful_polymorph_damage > u_health_comparison"
              ]
            },
            {
              "not": {
                "u_has_trait": "BIOMANCER_NPC_WRETCH_POLYMORPH"
              }
            }
          ]
        },
        "then": [
          {
            "npc_message": "<u_name> transforms into a fleshwarped wretch."
          },
          {
            "u_add_trait": "BIOMANCER_NPC_WRETCH_POLYMORPH"
          }
        ]
      }
    ]
  }
]
