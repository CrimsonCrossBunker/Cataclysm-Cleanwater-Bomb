  {
    "type": "effect_on_condition",
    "id": "EOC_XE_TROLL_HITS_YOU_WITH_GIANT_CLUB",
    "effect": [
      {
        "switch": { "math": [ "n_val('size')" ] },
        "cases": [
          {
            "case": 1,
            "effect": [ { "npc_add_effect": "downed", "duration": [ 2, 5 ] }, { "npc_add_effect": "stunned", "duration": [ 2, 5 ] } ]
          },
          {
            "case": 2,
            "effect": [
              { "npc_add_effect": "downed", "duration": [ 2, 4 ] },
              { "if": { "math": [ "rand(4) >= 1" ] }, "then": { "npc_add_effect": "stunned", "duration": [ 1, 4 ] } }
            ]
          },
          {
            "case": 3,
            "effect": [
              { "if": { "math": [ "rand(2) >= 1" ] }, "then": { "npc_add_effect": "downed", "duration": [ 1, 4 ] } },
              { "if": { "math": [ "rand(4) >= 2" ] }, "then": { "npc_add_effect": "stunned", "duration": [ 1, 3 ] } }
            ]
          },
          {
            "case": 4,
            "effect": [
              { "if": { "math": [ "rand(2) >= 2" ] }, "then": { "npc_add_effect": "downed", "duration": [ 1, 3 ] } },
              { "if": { "math": [ "rand(4) >= 3" ] }, "then": { "npc_add_effect": "stunned", "duration": [ 1, 2 ] } }
            ]
          },
