[
  {
    "type": "effect_on_condition",
    "id": "EOC_INVENTOR_CRAFTED_DEGRADATION",
    "recurrence": [ "1 d", "2 d" ],
    "global": true,
    "run_for_npcs": true,
    "condition": { "not": { "u_has_trait": "INVENTOR" } },
    "effect": {
      "u_run_inv_eocs": "all",
      "search_data": [ { "flags": [ "INVENTOR_CRAFTED" ] } ],
      "true_eocs": [
        {
          "id": "EOC_RUST_INVENTOR_ITEMS",
          "effect": [
            { "math": [ "n_hp('ALL') -= 2" ] },
            { "message": "You hear a sudden crack!" },
            {
              "u_message": "Your lack of an inventor's aura makes items created by their fevered mind rapidly degrade!"
            },
            { "npc_message": "My items are falling apart!  It isn't me!" }
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_INVENTOR_CBM_DEGRADATION",
    "recurrence": [ "1 d", "2 d" ],
    "global": true,
    "run_for_npcs": true,
    "condition": {
      "and": [
        { "not": { "u_has_trait": "INVENTOR" } },
        {
          "or": [
            { "u_has_bionics": "bio_inventor_mana_kj_penalty_switch" },
            { "u_has_bionics": "bio_inventor_calorie_storage" },
            { "u_has_bionics": "bio_inventor_creative_fuel" },
            { "u_has_bionics": "bio_inventor_book_burn_boost" }
          ]
        }
      ]
    },
    "effect": [ { "run_eocs": [ "EOC_INVENTOR_CBM_DEGRADATION_BREAKDOWN" ], "alpha_talker": "u" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_INVENTOR_CBM_DEGRADATION_BREAKDOWN",
    "//": "Inserting the effect inside the recurrent EOC fails to grant the faulty bionics through an invalid beta talker error.",
    "effect": [
      {
        "if": { "u_has_bionics": "bio_inventor_mana_kj_penalty_switch" },
        "then": [ { "u_lose_bionic": "bio_inventor_mana_kj_penalty_switch" }, { "u_add_bionic": "bio_power_weakness" } ]
      },
      {
        "if": { "u_has_bionics": "bio_inventor_calorie_storage" },
        "then": [ { "u_lose_bionic": "bio_inventor_calorie_storage" }, { "u_add_bionic": "bio_drain" } ]
      },
      {
        "if": { "u_has_bionics": "bio_inventor_creative_fuel" },
        "then": [ { "u_lose_bionic": "bio_inventor_creative_fuel" }, { "u_add_bionic": "bio_dis_shock" } ]
      },
      {
        "if": { "u_has_bionics": "bio_inventor_book_burn_boost" },
        "then": [ { "u_lose_bionic": "bio_inventor_book_burn_boost" }, { "u_add_bionic": "bio_leaky" } ]
      },
      { "message": "You hear a sudden crack!" },
      {
        "if": "u_is_avatar",
        "then": { "message": "Your lack of an inventor's aura is breaking the bionics that depend on it!" },
        "else": { "message": "My bionics are falling apart!  It isn't me!" }
      }
    ]
  },
  {
    "type": "effect_on_condition",
