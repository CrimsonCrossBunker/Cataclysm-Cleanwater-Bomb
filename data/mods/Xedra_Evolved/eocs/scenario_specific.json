[
  {
    "type": "effect_on_condition",
    "id": "EOC_SCENARIO_REVENANT_PERIODIC_FIX_NEEDS",
    "recurrence": [ "1 hours", "1 hours" ],
    "condition": { "u_has_profession": "xedra_revenant_prof" },
    "deactivate_condition": { "not": { "u_has_profession": "xedra_revenant_prof" } },
    "effect": [
      {
        "if": { "math": [ "u_calories('dont_affect_weariness': true) < 118000" ] },
        "then": { "math": [ "u_calories('dont_affect_weariness': true) = 118000" ] }
      },
      { "if": { "math": [ "u_val('sleepiness') > 0" ] }, "then": { "math": [ "u_val('sleepiness') = 0" ] } },
      {
        "if": { "math": [ "u_val('sleep_deprivation') > 0" ] },
        "then": { "math": [ "u_val('sleep_deprivation') = 0" ] }
      }
    ]
  }
]
