      "no": {
        "math": [ "Boann_Quests_Completed >= 6" ],
        "yes": "(Boann hands you a list) Here is a list of the quests to complete to become part of my court.  They are quite perilous, but their rewards are worth it.",
        "no": {
          "math": [ "Boann_Quests_Accepted == 6" ],
          "yes": "I have no new quests for now.  Once you've completed them, you'll become one of my knights and able to accomplish the quests that will make you a member of my court.",
          "no": "(Boann hands you a list) Here is a list of the quests to complete to become one of my knights.  Take your time, they can be accomplished at your prerogative."
        }
      }
    },
