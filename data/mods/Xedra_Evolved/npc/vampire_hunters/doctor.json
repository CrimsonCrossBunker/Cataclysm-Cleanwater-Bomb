  {
    "id": "TALK_HUNTER_DOCTOR",
    "type": "talk_topic",
    "dynamic_line": [
      {
        "u_has_trait": "VAMPIRE",
        "yes": [
          {
            "math": [ "vampire_hunters_owed_help > 0" ],
            "yes": "I can give you some cure for your vampirism.  You helped us, so I'll help you in turn.",
            "no": "Looking to buy the cure to your vampirism?  I would give it for free if I could, but its ingredients are so hard to find now.  Phyliss can help you if you're desperate."
          }
        ],
        "no": [ "Welcome.", "Hello.", "Hi.", "You need something?" ]
      }
    ],
    "responses": [
      {
        "text": "I have the ginseng you asked for.",
        "topic": "TALK_HUNTER_DOCTOR_FIND_GINSENG_COMPLETE",
        "condition": {
          "and": [
            { "u_has_item": "xe_elder_ginseng" },
            { "compare_string": [ "yes", { "u_val": "shared_with_hunter_doctor_life_extension_potion" } ] },
            { "not": { "compare_string": [ "yes", { "u_val": "gave_hunter_doctor_elder_ginseng" } ] } }
          ]
        },
        "effect": [
          { "u_sell_item": "xe_elder_ginseng", "count": 1 },
          { "u_add_var": "gave_hunter_doctor_elder_ginseng", "value": "yes" },
          { "finish_mission": "MISSION_VAMPIRE_HUNTER_DOCTOR_FIND_GINSENG", "success": true },
          { "math": [ "vampire_hunters_owed_help += 10" ] }
        ]
      },
      {
        "text": "[Show him your notes on aspirin improvement]",
        "topic": "TALK_HUNTER_DOCTOR_SHARE_ASPIRIN",
        "condition": {
          "and": [
            { "u_has_item": "alchemy_recipe_extra_str_aspirin" },
            { "not": { "compare_string": [ "yes", { "u_val": "shared_with_hunter_doctor_aspirin" } ] } }
          ]
        },
        "effect": [
          { "u_add_var": "shared_with_hunter_doctor_aspirin", "value": "yes" },
          { "math": [ "vampire_hunters_owed_help += 3" ] }
        ]
      },
      {
        "text": "[Show him your notes on overcharged energy drinks]",
        "topic": "TALK_HUNTER_DOCTOR_SHARE_RAGE_DRINK",
        "condition": {
          "and": [
            { "u_has_item": "alchemy_recipe_blackout_rage_drink" },
            { "not": { "compare_string": [ "yes", { "u_val": "shared_with_hunter_doctor_rage_drink" } ] } }
          ]
        },
        "effect": [
          { "u_add_var": "shared_with_hunter_doctor_rage_drink", "value": "yes" },
          { "math": [ "vampire_hunters_owed_help += 3" ] }
        ]
      },
      {
        "text": "[Show him your notes on precognition-inducing hallucinogens]",
        "topic": "TALK_HUNTER_DOCTOR_SHARE_LSD",
        "condition": {
          "and": [
            { "u_has_item": "alchemy_recipe_prophets_lsd" },
            { "not": { "compare_string": [ "yes", { "u_val": "shared_with_hunter_doctor_prophets_lsd" } ] } }
          ]
        },
        "effect": [
          { "u_add_var": "shared_with_hunter_doctor_prophets_lsd", "value": "yes" },
          { "math": [ "vampire_hunters_owed_help += 3" ] }
        ]
      },
      {
        "text": "[Show him your notes on the elixir of life]",
        "topic": "TALK_HUNTER_DOCTOR_SHARE_LIFE_ELIXIR",
        "condition": {
          "and": [
            { "u_has_item": "alchemy_recipe_life_extension_potion" },
            { "not": { "compare_string": [ "yes", { "u_val": "shared_with_hunter_doctor_life_extension_potion" } ] } }
          ]
        },
        "effect": [
          { "u_add_var": "shared_with_hunter_doctor_life_extension_potion", "value": "yes" },
          { "math": [ "vampire_hunters_owed_help += 3" ] }
        ]
      },
      {
        "text": "I'll buy some cure.  [10$]",
        "topic": "TALK_DONE",
        "condition": { "math": [ "vampire_hunters_owed_help < 1" ] },
        "effect": [ { "u_spend_cash": 2000, "true_eocs": "EOC_HUNTER_DOCTOR_GIVE_CURE" } ]
      },
      {
        "text": "I'd like to have some cure.",
        "topic": "TALK_HUNTER_DOCTOR_GIVE_CURE",
        "condition": { "math": [ "vampire_hunters_owed_help >= 1" ] },
        "effect": [
          { "math": [ "vampire_hunters_owed_help--" ] },
          { "u_spawn_item": "blood_treatment", "count": 3, "container": "bottle_plastic" }
        ]
      },
      {
        "text": "[30m] Could you patch me up?",
        "topic": "TALK_HUNTER_DOCTOR_AID_DONE",
        "effect": [ "give_aid", { "math": [ "vampire_hunters_owed_help--" ] } ],
        "condition": { "math": [ "vampire_hunters_owed_help > 0" ] }
      },
      {
        "text": "[1h] Could you to patch my friends up?",
        "topic": "TALK_HUNTER_DOCTOR_AID_DONE",
        "effect": [ "give_all_aid", { "math": [ "vampire_hunters_owed_help -= 2" ] } ],
        "condition": { "math": [ "vampire_hunters_owed_help > 1" ] }
      },
      { "text": "What's your role here?", "topic": "TALK_HUNTER_DOCTOR_INTRO" },
      { "text": "Do you have something to trade?", "topic": "TALK_HUNTER_DOCTOR", "effect": [ "start_trade" ] },
      {
        "text": "Do you have some free things for me?",
        "topic": "TALK_HUNTER_DOCTOR",
        "condition": { "math": [ "vampire_hunters_owed_help > 0" ] },
        "effect": [ "start_trade", { "u_spend_cash": -2000 }, { "math": [ "vampire_hunters_owed_help--" ] } ]
      },
      { "text": "<end_talking_bye>", "topic": "TALK_DONE" }
    ]
  }
]
