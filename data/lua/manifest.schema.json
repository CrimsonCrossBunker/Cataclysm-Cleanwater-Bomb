{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CrimsonCrossBunker/Cataclysm-Cleanwater-Bomb/raw/master/data/lua/manifest.schema.json",
  "title": "Cataclysm: Cleanwater Bomb Lua source manifest",
  "description": "Manifest for data/lua, an active Mod's lua directory, or config/lua.",
  "type": "object",
  "required": [
    "id",
    "version",
    "api_version",
    "capabilities",
    "dependencies"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Stable source id. A Mod manifest id must equal the Mod id.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "description": "Source-defined version shown to developers and service consumers.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "api_version": { "description": "Lua API contract requested by this source.", "type": "integer", "enum": [ 2, 3, 4 ] },
    "capabilities": {
      "description": "Explicit privileges granted to this source.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "events",
          "game.actions",
          "game.actions.dangerous",
          "game.read",
          "modules.import",
          "registry.read",
          "scheduler",
          "services.consume",
          "services.provide",
          "state.character",
          "state.page",
          "state.world",
          "ui.pages"
        ]
      }
    },
    "dependencies": {
      "description": "Earlier-loaded source ids that may be imported, observed, or called.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "enum": [ "game.actions.dangerous", "modules.import", "registry.read", "scheduler", "services.consume", "services.provide" ]
            }
          }
        },
        "required": [ "capabilities" ]
      },
      "then": { "properties": { "api_version": { "const": 4 } } }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "game.actions.dangerous" } } },
        "required": [ "capabilities" ]
      },
      "then": { "properties": { "capabilities": { "contains": { "const": "game.actions" } } } }
    }
  ],
  "additionalProperties": true
}
