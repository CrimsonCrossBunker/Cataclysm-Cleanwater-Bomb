{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CrimsonCrossBunker/Cataclysm-Cleanwater-Bomb/raw/master/data/lua/reference/ccb_public_api_v5.schema.json",
  "title": "CCB Lua API v5 public contract inventory",
  "type": "object",
  "required": [
    "schema_version",
    "$schema",
    "api_version",
    "generated_by",
    "denominator",
    "authority",
    "parity",
    "modules",
    "namespaces",
    "classes",
    "functions",
    "methods",
    "properties",
    "operators",
    "enums",
    "events",
    "hooks",
    "callbacks",
    "capabilities",
    "permissions",
    "manifest_fields"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "api_version": { "const": 5 },
    "generated_by": { "type": "string", "minLength": 1 },
    "denominator": { "$ref": "#/$defs/denominator" },
    "authority": { "type": "object", "minProperties": 1 },
    "parity": { "type": "object", "minProperties": 1 },
    "modules": { "$ref": "#/$defs/documentedArray" },
    "namespaces": { "$ref": "#/$defs/documentedArray" },
    "classes": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/documented" },
          {
            "type": "object",
            "required": [ "kind", "fields" ],
            "properties": { "kind": { "enum": [ "record", "native-usertype" ] }, "fields": { "$ref": "#/$defs/documentedArray" } }
          }
        ]
      }
    },
    "functions": { "$ref": "#/$defs/callableArray" },
    "methods": { "$ref": "#/$defs/callableArray" },
    "properties": { "$ref": "#/$defs/documentedArray" },
    "operators": { "$ref": "#/$defs/callableArray" },
    "enums": { "$ref": "#/$defs/documentedArray" },
    "events": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/documented" },
          {
            "type": "object",
            "required": [ "fields" ],
            "properties": { "fields": { "$ref": "#/$defs/documentedArray" } }
          }
        ]
      }
    },
    "hooks": { "$ref": "#/$defs/documentedArray" },
    "callbacks": { "$ref": "#/$defs/documentedArray" },
    "capabilities": { "$ref": "#/$defs/documentedArray" },
    "permissions": { "type": "object", "minProperties": 1 },
    "manifest_fields": { "$ref": "#/$defs/documentedArray" }
  },
  "additionalProperties": false,
  "$defs": {
    "denominator": {
      "type": "object",
      "required": [ "definition", "exclusions" ],
      "properties": {
        "definition": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [ "path", "line", "authority" ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "authority": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": [ "id", "status" ],
      "properties": {
        "id": { "type": "string", "pattern": "^api\\.lua\\.v5\\.generated\\." },
        "status": { "const": "generated-contract-source" }
      },
      "additionalProperties": false
    },
    "documented": {
      "type": "object",
      "required": [ "sources", "documentation" ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "documentation": { "$ref": "#/$defs/documentation" }
      }
    },
    "documentedArray": { "type": "array", "items": { "$ref": "#/$defs/documented" } },
    "parameter": {
      "type": "object",
      "required": [ "name", "optional", "declaration" ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "declaration": { "type": "string", "minLength": 1 }
      }
    },
    "return": {
      "type": "object",
      "required": [ "declaration" ],
      "properties": { "declaration": { "type": "string", "minLength": 1 } }
    },
    "callable": {
      "allOf": [
        { "$ref": "#/$defs/documented" },
        {
          "type": "object",
          "required": [
            "parameters",
            "returns",
            "errors",
            "api_version",
            "since",
            "deprecated",
            "deprecation_replacement",
            "capabilities",
            "examples"
          ],
          "properties": {
            "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
            "returns": { "type": "array", "items": { "$ref": "#/$defs/return" } },
            "errors": { "type": "object", "minProperties": 1 },
            "api_version": { "const": 5 },
            "since": { "type": "string", "minLength": 1 },
            "deprecated": { "type": "boolean" },
            "deprecation_replacement": { "type": [ "string", "null" ] },
            "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "examples": { "type": "array" }
          }
        }
      ]
    },
    "callableArray": { "type": "array", "items": { "$ref": "#/$defs/callable" } }
  }
}
